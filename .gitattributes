# LF everywhere in the repo and working tree (gofmt, Vite and Wails expect
# it). Overrides a machine's core.autocrlf=true, which otherwise checks
# every file out as CRLF on Windows.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.nsi text eol=crlf

# Fixtures compared byte for byte: never convert them.
**/testdata/** -text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.wasm binary
*.lottie binary
*.zip binary
