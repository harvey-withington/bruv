{
  // Four top-level debug workflows (prefixed "Debug:"):
  //   1. Client with internal server — Wails desktop, embedded server
  //   2. Client + external server    — compound: server + Wails desktop
  //   3. Mobile + server             — compound: server + mobile vite
  //   4. Desktop + mobile            — compound: Wails desktop + mobile
  //      vite riding the DESKTOP's embedded server (one backend, both
  //      surfaces at once — spawning bruv-server alongside would fight
  //      the desktop supervisor for the same repo locks)
  //
  // The "Run:" entries are building blocks the compounds chain
  // together. They exist as launches (rather than tasks) because
  // VS Code compounds can only reference launch configurations.
  //
  // Standalone "run this binary" shortcuts (no debugger) live in
  // tasks.json — see 'bruv: run server' and 'wails: build & run'.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run: Server (delve)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/bruv-server",
      // 9871, not 9870: the desktop app now defaults to 9870, and the
      // compounds below run this ALONGSIDE it. Sharing a port would make
      // whichever booted second fall back silently-ish (it toasts) and
      // leave the mobile proxy pointing at the wrong process. Both stay
      // inside the 9870-9879 range the clipper's detection probes.
      "args": ["--addr", "127.0.0.1:9871"],
      "cwd": "${workspaceFolder}",
      // Park the compiled debug binary in the OS temp dir instead of
      // letting delve drop it into cmd/bruv-server/. Crashed/force-
      // killed sessions otherwise leave __debug_bin*.exe cruft behind
      // in the source tree; TEMP gets cleaned by the OS regardless.
      "output": "${env:TEMP}/bruv-server-dlv-debug",
      // Route the server's stdout/stderr to an integrated terminal
      // rather than the Debug Console. In a compound launch, the Debug
      // Console only shows one session at a time (selected via dropdown);
      // a silent bind failure on 9870 is invisible unless you happen to
      // be on the right tab. Terminal tabs are always visible.
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Run: Mobile vite dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/mobile",
      "preLaunchTask": "bootstrap: mobile deps"
    },
    {
      "name": "Run: Mobile vite dev (desktop backend)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/mobile",
      "preLaunchTask": "bootstrap: mobile deps",
      // Rides the DESKTOP app's embedded server instead of spawning
      // bruv-server. 9870 is the desktop app's default local port
      // (override in Settings → General → "local server port", and here
      // to match). If the app reports a port clash on boot — e.g.
      // bruv-server is already holding 9870 from another session — it
      // moves within 9870-9879 and toasts the port it got; point this
      // at that port. Vite starts faster than the desktop binds: early
      // proxy errors in the terminal just mean the app is still
      // launching.
      "env": { "VITE_BACKEND": "http://127.0.0.1:9870" }
    },
    {
      "name": "Debug: Client with internal server",
      "type": "node-terminal",
      "request": "launch",
      "command": "wails dev",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "bootstrap: frontend deps"
    }
  ],
  "compounds": [
    {
      "name": "Debug: Mobile + server",
      "configurations": ["Run: Server (delve)", "Run: Mobile vite dev"],
      "stopAll": true
    },
    {
      "name": "Debug: Client + external server",
      "configurations": ["Run: Server (delve)", "Debug: Client with internal server"],
      "stopAll": true
    },
    {
      "name": "Debug: Desktop + mobile (one server)",
      "configurations": ["Debug: Client with internal server", "Run: Mobile vite dev (desktop backend)"],
      "stopAll": true
    }
  ]
}
